#!/usr/bin/groovy
def props


pipeline {
    agent {
        kubernetes {
            cloud "da-hpp-ccd-openshift-devops1"
            label "ccd-web-pod"
            customWorkspace "/home/jenkins/agent/workspace"
            defaultContainer "cloudkit"
            yamlFile ".cicd/build-agent.yaml"
        }
    }
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        ansiColor('xterm')
        timestamps()
        disableConcurrentBuilds()
    }
    environment {
        ROLE_NAME = "HPNCCDJENKINS"
        PLUGINDIR = "${WORKSPACE}/terraform.d/plugins/linux_amd64"
        WEBEX_HOOK = "https://webexapis.com/v1/webhooks/incoming/Y2lzY29zcGFyazovL3VzL1dFQkhPT0svN2Y5ZTU4NGQtZDBmYi00ZjFhLTg1MDQtM2FmZDNiZGU3NzA4"
        TEAMS_WEBHOOK = "https://default791b26cb3fdf47c3b85dbd9f037e3e.7f.environment.api.powerplatform.com:443/powerautomate/automations/direct/workflows/51f1e70673f94ef0ae2f12ff53b6a209/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=mhcu-uFVL2CZL6QquNxtuzwpvqaR28r53NQNi88fRIA"
        CX_CREDENTIALS = credentials('checkmarx_credentials')
        CX_TEAM = "HPP"
        CX_PROJECT_NAME = "jakshwealth-ui"
        CX_EMAIL = "mrinal.patwardhan@evernorth.com"
        CX_PROJECT_PATH = "CxServer/Cigna"
        CX_SERVER = "https://cigna.checkmarx.net"
        S3_BUCKET_PREFIX = "jakshwealth-ui"
    }
    stages {
        stage ('Set Environment') {
            steps {
                script {
                    if (env.BRANCH_NAME == 'master' || env.BRANCH_NAME == 'main') {
                        props = readProperties file: "${WORKSPACE}/.cicd/build_props/prod-build.properties"
                    } else if (env.BRANCH_NAME == 'test') {
                        props = readProperties file: "${WORKSPACE}/.cicd/build_props/test-build.properties"
                    } else {
                        props = readProperties file: "${WORKSPACE}/.cicd/build_props/dev-build.properties"
                    }
                    env.AWS_PROFILE = props.aws_profile ?: 'jakshwealth'
                    env.AWS_ACCOUNT_NUMBER = props.account_number
                    env.AWS_REGION = props.aws_region ?: 'us-east-1'
                    env.DEPLOY_ENV = props.deploy_env
                }

            }
        }
        stage('ci-lint') {
            steps {
                container('ccdweb') {
                    sh """
                    export NPM_CONFIG_CACHE=~/.npmcache
                    npm cache clean --force
                    npm ci
                    npm run lint
                    """
                }
            }
        }
        stage('ParallelExecution') {
            parallel {
                stage('test') {
                    when {
                        branch 'dev'
                    }
                    steps {
                        container('ccdweb') {
                            sh '''
                            export NODE_OPTIONS=--max_old_space_size=8192
                            npm run test
                            '''
                        }
                    }
                }

                // Checkmarx stage temporarily disabled during Checkmarx migration
                // stage('checkmarx-security-scan') {
                //     steps {
                //         container('cx-toolshack') {
                //             script {
                //                 withCredentials([usernamePassword(credentialsId: 'checkmarx_credentials', passwordVariable: 'CX_CREDENTIALS_PSW', usernameVariable: 'CX_CREDENTIALS_USR')]) {
                //                     sh '''
                //                     java -jar /cxtools/CLI/CxConsolePlugin-CLI.jar Scan -v \
                //                     -config /cxtools/CLI/config/cx_console.properties \
                //                     -CxServer $CX_SERVER \
                //                     -ProjectName "${CX_PROJECT_PATH}/${CX_TEAM}/${CX_PROJECT_NAME}" \
                //                     -CxUser hpp_api \
                //                     -CxPassword ${CX_CREDENTIALS_PSW} \
                //                     -LocationType folder \
                //                     -LocationPath . \
                //                     -Configuration "Multi-Language Scan" \
                //                     -ReportPDF checkmarxReport.pdf
                //                     '''
                //                     def reportFile = '/home/jenkins/agent/workspace/Checkmarx/Reports/checkmarxReport.pdf'
                //                     if (fileExists(reportFile)) {
                //                         emailext subject: "Checkmarx Scan Result for Project: ${CX_PROJECT_NAME}",
                //                                 body: "Attached is your Checkmarx scan result, and summary output file. Flaws identified as Very-High or High, must be addressed immediately.",
                //                                 attachmentsPattern: '**/checkmarxReport.*',
                //                                 to: "${CX_EMAIL}"
                //                     }
                //                 }
                //             }
                //         }
                //     }
                // }
                stage('build') {
                    steps {
                        container('ccdweb') {
                            sh """
                            npm run build${DEPLOY_ENV.capitalize()}
                            """
                        }
                    }
                }
            }
        }
        stage ('Verify AWS credentials') {
            steps {
                sh """
                    export AWS_PROFILE=${AWS_PROFILE}
                    export AWS_DEFAULT_REGION=${AWS_REGION}
                    aws sts get-caller-identity
                """
            }
        }
        stage ('Push to S3') {
            steps {
                sh """
                export AWS_PROFILE=${AWS_PROFILE}
                export AWS_DEFAULT_REGION=${AWS_REGION}
                aws sts get-caller-identity

                aws s3 sync ${WORKSPACE}/dist/browser/. s3://${S3_BUCKET_PREFIX}-${DEPLOY_ENV}/ --delete
                """
            }
        }
        stage ('Invalidation') {
            steps {
                sh """
                export AWS_PROFILE=${AWS_PROFILE}
                export AWS_DEFAULT_REGION=${AWS_REGION}
                aws sts get-caller-identity

                aws --region us-east-1 cloudfront create-invalidation --distribution-id `aws cloudfront list-distributions --query "DistributionList.Items[*].{id:Id,origin:Origins.Items[0].Id}[?origin=='S3-${S3_BUCKET_PREFIX}-${DEPLOY_ENV}'].id" --output text` --paths "/*"
                """
            }
        }
    }
    post {
        failure {
            sh """
                curl -X POST -H "Content-Type: application/json" \
                -d '{"markdown": "Build INFO hpp-self-service-analytics-ui: ${JOB_BASE_NAME} <br> Branch: ${BRANCH_NAME} <br> Build Number: ${BUILD_NUMBER} <br> Environment: ${DEPLOY_ENV} <br> SSA UI: Build ${currentBuild.result} <br> Build Log: ${BUILD_URL}"}' ${WEBEX_HOOK}
            """
            sh '''
                cat > /tmp/teams_payload.json << EOFTEAMS
{
    "type": "message",
    "attachments": [
        {
            "contentType": "application/vnd.microsoft.card.adaptive",
            "contentUrl": null,
            "content": {
                "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                "type": "AdaptiveCard",
                "version": "1.4",
                "body": [
                    {
                        "type": "TextBlock",
                        "size": "Large",
                        "weight": "Bolder",
                        "color": "Attention",
                        "text": "❌ SSA UI Build FAILED"
                    },
                    {
                        "type": "FactSet",
                        "facts": [
                            { "title": "Job:", "value": "REPLACE_JOB" },
                            { "title": "Branch:", "value": "REPLACE_BRANCH" },
                            { "title": "Build #:", "value": "REPLACE_BUILD_NUM" },
                            { "title": "Environment:", "value": "REPLACE_ENV" }
                        ]
                    },
                    {
                        "type": "ActionSet",
                        "actions": [
                            {
                                "type": "Action.OpenUrl",
                                "title": "View Build Log",
                                "url": "REPLACE_URL"
                            }
                        ]
                    }
                ]
            }
        }
    ]
}
EOFTEAMS
                sed -i "s|REPLACE_JOB|${JOB_BASE_NAME}|g" /tmp/teams_payload.json
                sed -i "s|REPLACE_BRANCH|${BRANCH_NAME}|g" /tmp/teams_payload.json
                sed -i "s|REPLACE_BUILD_NUM|${BUILD_NUMBER}|g" /tmp/teams_payload.json
                sed -i "s|REPLACE_ENV|${DEPLOY_ENV}|g" /tmp/teams_payload.json
                sed -i "s|REPLACE_URL|${BUILD_URL}|g" /tmp/teams_payload.json
                curl -X POST -H "Content-Type: application/json" \
                    -d @/tmp/teams_payload.json \
                    "${TEAMS_WEBHOOK}"
            '''
        }
        success {
            sh """
                curl -X POST -H "Content-Type: application/json" \
                -d '{"markdown": "Build INFO hpp-self-service-analytics-ui: ${JOB_BASE_NAME} <br> Branch: ${BRANCH_NAME} <br> Build Number: ${BUILD_NUMBER} <br> Environment: ${DEPLOY_ENV} <br> SSA UI: Build ${currentBuild.result} <br> Build Log: ${BUILD_URL}"}' ${WEBEX_HOOK}
            """
            sh '''
                cat > /tmp/teams_payload.json << EOFTEAMS
{
    "type": "message",
    "attachments": [
        {
            "contentType": "application/vnd.microsoft.card.adaptive",
            "contentUrl": null,
            "content": {
                "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                "type": "AdaptiveCard",
                "version": "1.4",
                "body": [
                    {
                        "type": "TextBlock",
                        "size": "Large",
                        "weight": "Bolder",
                        "color": "Good",
                        "text": "✅ SSA UI Build SUCCESS"
                    },
                    {
                        "type": "FactSet",
                        "facts": [
                            { "title": "Job:", "value": "REPLACE_JOB" },
                            { "title": "Branch:", "value": "REPLACE_BRANCH" },
                            { "title": "Build #:", "value": "REPLACE_BUILD_NUM" },
                            { "title": "Environment:", "value": "REPLACE_ENV" }
                        ]
                    },
                    {
                        "type": "ActionSet",
                        "actions": [
                            {
                                "type": "Action.OpenUrl",
                                "title": "View Build Log",
                                "url": "REPLACE_URL"
                            }
                        ]
                    }
                ]
            }
        }
    ]
}
EOFTEAMS
                sed -i "s|REPLACE_JOB|${JOB_BASE_NAME}|g" /tmp/teams_payload.json
                sed -i "s|REPLACE_BRANCH|${BRANCH_NAME}|g" /tmp/teams_payload.json
                sed -i "s|REPLACE_BUILD_NUM|${BUILD_NUMBER}|g" /tmp/teams_payload.json
                sed -i "s|REPLACE_ENV|${DEPLOY_ENV}|g" /tmp/teams_payload.json
                sed -i "s|REPLACE_URL|${BUILD_URL}|g" /tmp/teams_payload.json
                curl -X POST -H "Content-Type: application/json" \
                    -d @/tmp/teams_payload.json \
                    "${TEAMS_WEBHOOK}"
            '''
        }
    }
}
